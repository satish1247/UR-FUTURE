# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin (server only) — Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=demo-urfuture
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with \n escapes, wrapped in double quotes
FIREBASE_PRIVATE_KEY=

# Local dev against the emulator (remove in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080




# MCP bearer token (the AI agent connector sends "Authorization: Bearer <this>")
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SECRET=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically
CRON_SECRET=
# Firebase web config (public) — Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Email alerts — Brevo > Settings > SMTP & API > API keys (and a verified sender)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UR Future Jobs

# Telegram alerts — @BotFather token and the bot username (without @)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
